# AniList MCP Configuration

# Optional: AniList OAuth Bearer Token for authenticated requests
ANILIST_TOKEN=

# Transport mode: stdio (for local desktop LLM clients) or sse (for HTTP/Docker)
TRANSPORT=sse

# HTTP server port & host (when TRANSPORT=sse)
PORT=3000
HOST=0.0.0.0

# Logging level: debug, info, warn, error
LOG_LEVEL=info
