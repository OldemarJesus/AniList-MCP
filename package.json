{
  "name": "anilist-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for AniList, built with Node.js and TypeScript reusing anilist-node",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "anilist-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist coverage",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anilist",
    "anime",
    "manga",
    "ai",
    "llm",
    "agents"
  ],
  "author": "Oldemar Jesus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OldemarJesus/AniList-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/OldemarJesus/AniList-MCP/issues"
  },
  "homepage": "https://github.com/OldemarJesus/AniList-MCP#readme",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "anilist-node": "^1.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}